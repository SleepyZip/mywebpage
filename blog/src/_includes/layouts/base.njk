<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != "Blog" %}{{ title }} | {% endif %}Trevor DeMelo | Blog</title>
  <meta name="description" content="{{ summary or 'Notes on IT, networking, and things I have built.' }}">
  <link rel="canonical" href="https://trevordemelo.com{{ base }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="Trevor DeMelo | Blog" href="{{ base }}/feed.xml">
  <link rel="icon" type="image/svg+xml" href="/assets/duck.svg">
  <meta property="og:title" content="{{ title or 'Blog' }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="https://trevordemelo.com{{ base }}{{ page.url }}">
  {# Apply a saved light theme before paint (same one-liner as the main site). #}
  <script>try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}</script>
  {# Shared Solarized look, served by the Worker for the whole site. #}
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <div class="sky" aria-hidden="true"></div>
  <div class="container">
    <nav>
      <div>
        <a href="/">HOME</a>
        <a href="/projects">PROJECTS</a>
        <a href="{{ base }}/" aria-current="page">BLOG</a>
      </div>
      <div class="nav-right">
        <button type="button" class="nav-icon-btn theme-toggle" aria-label="Switch to light theme" title="Switch theme"><svg class="icon-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4"/></svg><svg class="icon-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7z"/></svg><span class="theme-rest" aria-hidden="true"><span class="theme-word theme-word-light">Light</span><span class="theme-sep">/</span><span class="theme-word theme-word-dark">Dark</span></span></button>
        <a href="/admin" class="nav-icon-btn portal-link" aria-label="Admin Portal"><span class="portal-a" aria-hidden="true">A</span><span class="portal-rest" aria-hidden="true">dmin Portal</span></a>
      </div>
    </nav>
    {{ content | safe }}
  </div>
  <script src="/assets/site.js" defer></script>
</body>
</html>
