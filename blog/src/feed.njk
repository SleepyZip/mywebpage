---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Trevor DeMelo | Blog</title>
  <subtitle>Notes on IT, networking, and things I've built.</subtitle>
  <link href="{{ siteUrl }}{{ base }}/feed.xml" rel="self"/>
  <link href="{{ siteUrl }}{{ base }}/"/>
  <id>{{ siteUrl }}{{ base }}/</id>
  <updated>{{ (collections.posts | first).date.toISOString() if collections.posts | length else "2026-09-28T00:00:00.000Z" }}</updated>
  <author><name>Trevor DeMelo</name></author>
  {%- for post in collections.posts | head(20) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ siteUrl }}{{ base }}{{ post.url }}"/>
    <id>{{ siteUrl }}{{ base }}{{ post.url }}</id>
    <updated>{{ post.date.toISOString() }}</updated>
    {%- if post.data.summary %}
    <summary>{{ post.data.summary }}</summary>
    {%- endif %}
    <content type="html">{{ post.content | absoluteLinks }}</content>
  </entry>
  {%- endfor %}
</feed>
